# Home Assistant base URL (http/https) or full WebSocket URL (ws/wss .../api/websocket).
# Must be reachable from wherever the gateway runs (on Railway: a public URL such as Nabu Casa or a tunnel).
HA_URL=https://homeassistant.example.com
# Long-lived access token (HA profile → Security → Long-lived access tokens).
HA_TOKEN=

# Per-app variables. Each app's file in src/apps/ names the env vars it reads.
# Cam Quest: API key for its actions (32+ chars, e.g. `openssl rand -hex 32`),
# plus where its events are POSTed.
CAM_QUEST_API_KEY=
CAM_QUEST_WEBHOOK_URL=
CAM_QUEST_WEBHOOK_SECRET=
# Skill ID of Cam Quest's Alexa skill (amzn1.ask.skill.…), from the Alexa developer console.
CAM_QUEST_ALEXA_SKILL_ID=

# Optional.
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
