# Home Assistant base URL (http/https) or full WebSocket URL (ws/wss .../api/websocket).
# Must be reachable from wherever the gateway runs (on Railway: a public URL such as Nabu Casa or a tunnel).
HA_URL=https://homeassistant.example.com
# Long-lived access token (HA profile → Security → Long-lived access tokens).
HA_TOKEN=

# Optional. Shared secret apps send as "Authorization: Bearer <key>" for /v1 routes.
# Minimum 32 characters. If unset, all /v1 routes return 503 (fail closed).
GATEWAY_API_KEY=

# Optional. Webhook destinations are declared in src/config/events.ts; their URLs/secrets go here.
CAM_QUEST_WEBHOOK_URL=
CAM_QUEST_WEBHOOK_SECRET=

# Optional.
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
